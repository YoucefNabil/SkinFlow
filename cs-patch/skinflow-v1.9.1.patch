diff --git a/src/Features/SkinFlowAPI.h b/src/Features/SkinFlowAPI.h
new file mode 100644
index 0000000..bc8b2d0
--- /dev/null
+++ b/src/Features/SkinFlowAPI.h
@@ -0,0 +1,50 @@
+#pragma once
+// SkinFlow public C API (render thread only).
+// A renderer (Community Shaders' Advanced Skin) calls SkinFlow_GetSurface from
+// BSLightingShader::SetupGeometry and binds the returned SRV for that draw.
+
+#include <cstdint>
+
+struct ID3D11ShaderResourceView;
+namespace RE
+{
+	class BSRenderPass;
+}
+
+#define SKINFLOW_API_VERSION 4u
+
+enum class SkinFlowView : std::uint32_t
+{
+	kSweat = 0,    // sweat drops, runs and sheen on the skin's wetness layer
+	kGravity = 1,  // debug: speckle flowing downhill, red on steep skin, blue on flat
+	kWater = 2,    // debug: the simulated water as a heat map
+};
+
+// How the sweat looks; the same for every surface (SkinFlow.ini [Look]).
+struct SkinFlowLook
+{
+	float dropSize = 0.8f;  // drawn drop size multiplier (the simulation decides where drops are)
+	float sheen = 1.0f;     // gloss of the film the water leaves on the skin
+};
+
+struct SkinFlowSurface
+{
+	// RGBA16F in the UV space of the drawn mesh: xy = downhill direction (length = sine of the
+	// slope), z = outward normal .z, w = coverage.
+	ID3D11ShaderResourceView* srv = nullptr;
+	// RGBA32F, same UV space: x = simulated water (1 = a drop heavy enough to run down vertical skin),
+	// y = trail wetness left where drops ran (1 fresh, fading out), z = a running drop's way to the
+	// next texel (0..1), w = 1 + the direction of that texel (0 = resting). See Flow.hlsl.
+	ID3D11ShaderResourceView* water = nullptr;
+	float amount = 0.0f;   // sweat amount 0..1, before the renderer adds its own exertion wetness
+	float uvScale = 0.0f;  // world units per UV unit on this surface, 0 while not measured yet
+	SkinFlowView view = SkinFlowView::kSweat;
+	SkinFlowLook look{};
+};
+
+extern "C"
+{
+	using SkinFlow_GetApiVersion_t = std::uint32_t (*)();
+	// Returns false when this pass is not simulated skin (caller keeps its own path).
+	using SkinFlow_GetSurface_t = bool (*)(RE::BSRenderPass* a_pass, SkinFlowSurface* a_out);
+}
diff --git a/src/Features/SkinFlowBridge.cpp b/src/Features/SkinFlowBridge.cpp
new file mode 100644
index 0000000..56698bd
--- /dev/null
+++ b/src/Features/SkinFlowBridge.cpp
@@ -0,0 +1,76 @@
+#include "SkinFlowBridge.h"
+
+#include "Globals.h"
+#include "ShaderCache.h"
+
+void SkinFlowBridge::Resolve()
+{
+	resolved = true;
+	const HMODULE module = GetModuleHandleW(L"SkinFlow.dll");
+	if (!module) {
+		logger::info("[Advanced Skin] SkinFlow.dll not loaded, built-in wetness only");
+		return;
+	}
+	const auto getVersion = reinterpret_cast<SkinFlow_GetApiVersion_t>(GetProcAddress(module, "SkinFlow_GetApiVersion"));
+	const uint32_t version = getVersion ? getVersion() : 0;
+	if (version != SKINFLOW_API_VERSION) {
+		logger::warn("[Advanced Skin] SkinFlow.dll API version {} (expected {}), ignored", version, SKINFLOW_API_VERSION);
+		return;
+	}
+	getSurface = reinterpret_cast<SkinFlow_GetSurface_t>(GetProcAddress(module, "SkinFlow_GetSurface"));
+	logger::info("[Advanced Skin] SkinFlow.dll API {} found", version);
+}
+
+bool SkinFlowBridge::Available()
+{
+	if (!resolved) {
+		Resolve();
+	}
+	return getSurface != nullptr;
+}
+
+SkinFlowBridge::Params SkinFlowBridge::Bind(ID3D11DeviceContext* a_context, RE::BSRenderPass* a_pass)
+{
+	if (!resolved) {
+		Resolve();
+	}
+	SkinFlowSurface surface{};
+	if (!getSurface || !getSurface(a_pass, &surface) || !surface.srv || !surface.water) {
+		return {};
+	}
+	a_context->PSSetShaderResources(kTextureSlot, 1, &surface.srv);
+	a_context->PSSetShaderResources(kWaterSlot, 1, &surface.water);
+	return {
+		float4(1.0f, static_cast<float>(surface.view), surface.amount, surface.uvScale),
+		float4(surface.look.dropSize, surface.look.sheen, 0.0f, 0.0f)
+	};
+}
+
+void SkinFlowShaderWatch::Poll()
+{
+	const auto now = std::chrono::steady_clock::now();
+	if (now < nextCheck) {
+		return;
+	}
+	nextCheck = now + std::chrono::seconds(1);
+
+	std::error_code error;
+	const auto time = std::filesystem::last_write_time(L"Data\\Shaders\\Lighting.hlsl", error);
+	if (error) {
+		return;
+	}
+	if (!known || time == lightingTime) {
+		known = true;
+		lightingTime = time;
+		return;
+	}
+	lightingTime = time;
+
+	auto* cache = globals::shaderCache;
+	if (cache->IsDiskCache() && !cache->IsSkipUnchangedShaders() && !warnedDiskCache) {
+		warnedDiskCache = true;
+		logger::warn("[Advanced Skin] Lighting.hlsl changed, but the disk cache is on without Skip Unchanged Shaders: old shaders may come back from disk");
+	}
+	logger::info("[Advanced Skin] Lighting.hlsl changed: recompiling the Lighting shaders");
+	cache->Clear(RE::BSShader::Type::Lighting);
+}
